# Server-side secrets — configure in Lovable Cloud → Project Settings → Secrets.
# Never commit real values. Never prefix these with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Health Connect Report Analyzer

# Comma-separated list of frontend origins allowed to call the analyze-report
# function. Leave empty during local development.
ALLOWED_ORIGINS=
