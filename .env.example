# Server-side secret for local Vercel development and Vercel deployment.
# Never commit a real value. Configure the deployed value in Vercel's environment settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Health Connect Report Analyzer

# Lovable Cloud edge-function CORS setting; not used by the Vercel API.
ALLOWED_ORIGINS=
# Optional allowlist for browser origins calling Vercel endpoints cross-origin.
VERCEL_ALLOWED_ORIGINS=

# Public Lovable Cloud settings (safe for browser use; never put a service key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "vercel" for Vercel builds using a custom domain or `vercel dev`.
# Leave blank to auto-select Vercel on *.vercel.app and Lovable Cloud elsewhere.
VITE_REPORT_ANALYSIS_API=
